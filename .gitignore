# ============================================================================
# Gitignore for KiCad Projects (for a repo with multiple project folders)
# ============================================================================
#
# This file is intended to be placed in the root directory of your repository.
# It ignores files that are auto-generated, user-specific, or manufacturing
# outputs, which should not be version controlled.

# ----------------------------------------------------------------------------
# General Backup and Recovery Files
# These are automatically created by KiCad.
# ----------------------------------------------------------------------------
*.bak
*-bak.*
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_pro.bak
*.kicad_wks-bak
*.kicad_prl
*.wbk
_autosave-*

# ----------------------------------------------------------------------------
# Cache and Temporary Files
# These can be regenerated by KiCad and are not needed.
# ----------------------------------------------------------------------------
fp-info-cache
*.net
*.dcm
*-archive/
lib-archive

# ----------------------------------------------------------------------------
# Generated Log and Report Files
# These are generated by DRC, ERC, etc.
# ----------------------------------------------------------------------------
*.log
*.rpt
*.erc
*.drc
*.cmp

# ----------------------------------------------------------------------------
# Fabrication and Output Files (Gerbers, PDFs, BOMs, etc.)
# These are build artifacts. It's better to track the source and regenerate them.
# ----------------------------------------------------------------------------
*.gbr
*.gerber
*.drl
*.xln
*.pdf
*.plt
*.svg
*.ps
*.step
*.stp
*.iges
*.igs
*.wrl
*.bom
*.pos
*.cpl

# ----------------------------------------------------------------------------
# User-Specific Local Settings
# These store your personal editor settings and library table paths.
# They should not be shared across different computers or users.
# ----------------------------------------------------------------------------
*.pro.user
*.kicad_pro.user
*.kicad_wks.user
*.kicad_pcb.user
*.kicad_sch.user
sym-lib-table
fp-lib-table

# ----------------------------------------------------------------------------
# KiCad Backup Directory
# ----------------------------------------------------------------------------
backup/

# ----------------------------------------------------------------------------
# 3D Model Cache (Legacy)
# ----------------------------------------------------------------------------
*.3dshapes/

# ----------------------------------------------------------------------------
# Common OS and Editor junk files
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/